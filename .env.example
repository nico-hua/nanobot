# Runtime logging. Valid values include DEBUG, INFO, WARNING, ERROR, and CRITICAL.
NANOBOT_LOG_LEVEL=INFO

# Enable the manual QQ -> Agent -> DeepSeek -> tool -> QQ live test.
NANOBOT_RUN_QQ_DEEPSEEK_LIVE_TESTS=0

# QQ Bot credentials.
NANOBOT_QQ_APP_ID=
NANOBOT_QQ_SECRET=

# Comma-separated QQ user OpenIDs permitted to use the bot. Use * to allow all.
NANOBOT_QQ_ALLOW_FROM=*

# DeepSeek OpenAI-compatible API configuration.
NANOBOT_DEEPSEEK_API_KEY=
NANOBOT_DEEPSEEK_API_BASE=https://api.deepseek.com
NANOBOT_DEEPSEEK_MODEL=deepseek-chat

# Maximum time the manual test waits for a QQ reply, in seconds.
NANOBOT_QQ_LIVE_TEST_TIMEOUT_SECONDS=180
