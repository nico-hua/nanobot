# Sensitive runtime configuration. Non-sensitive settings belong in .nanobot/nanobot.json.
# Browser-visible WebSocket endpoint for webui. Keep it aligned with
# channel.websocket in .nanobot/nanobot.json.
VITE_NANOBOT_WEBSOCKET_URL=ws://127.0.0.1:8765/ws
# Browser-visible local HTTP API endpoint for saved-session reads. Keep it
# aligned with api.host and api.port in .nanobot/nanobot.json.
VITE_NANOBOT_API_URL=http://127.0.0.1:8000
NANOBOT_API_KEY=


# QQ Bot credentials.
NANOBOT_QQ_APP_ID=
NANOBOT_QQ_SECRET=
# Comma-separated QQ user OpenIDs permitted to use the bot. Use * to allow all.
NANOBOT_QQ_ALLOW_FROM=*
# Maximum time the manual test waits for a QQ reply, in seconds.
NANOBOT_QQ_LIVE_TEST_TIMEOUT_SECONDS=180
