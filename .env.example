# Browser-visible Web UI configuration only. Backend Agent settings and
# credentials belong in the local .nanobot/nanobot.json file.
# Keep this endpoint aligned with channel.websocket in nanobot.json.
VITE_NANOBOT_WEBSOCKET_URL=ws://127.0.0.1:8765/ws
# Keep this endpoint aligned with api.host and api.port in nanobot.json.
VITE_NANOBOT_API_URL=http://127.0.0.1:8000
# Set this only when auth.enabled is true, using the local auth.token value
# from nanobot.json. It is intentionally browser-visible.
VITE_NANOBOT_AUTH_TOKEN=
