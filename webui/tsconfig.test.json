{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./.test-build",
    "noEmit": false,
    "declaration": false,
    "jsx": "react-jsx"
  },
  "include": [
    "src/components/MessageContent.tsx",
    "src/commands.ts",
    "src/conversationScroll.ts",
    "src/hooks/chatState.ts",
    "src/hooks/webSocketConnection.ts",
    "src/api/sessions.ts",
    "src/types/protocol.ts"
  ]
}
